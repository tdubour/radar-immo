{
  "manifest_version": 3,
  "name": "Berry Multi-Source Connector",
  "description": "Collecteur immobilier multi-application et multi-recherche pour BerryPilot, Radar Immo et les futurs outils.",
  "version": "1.1.0",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "alarms", "tabs", "activeTab"],
  "host_permissions": [
    "*://*.leboncoin.fr/*",
    "*://*.seloger.com/*",
    "*://*.bienici.com/*",
    "*://*.pap.fr/*",
    "*://*.logic-immo.com/*",
    "https://berryconciergerie-app.vercel.app/*"
  ],
  "optional_host_permissions": ["https://*/*", "http://localhost/*"],
  "background": {
    "service_worker": "dist/background.js",
    "type": "module"
  },
  "action": {
    "default_title": "Berry Connector",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "*://*.leboncoin.fr/*",
        "*://*.seloger.com/*",
        "*://*.bienici.com/*",
        "*://*.pap.fr/*",
        "*://*.logic-immo.com/*"
      ],
      "js": ["dist/content.js"],
      "run_at": "document_idle"
    }
  ]
}
